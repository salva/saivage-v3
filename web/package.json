{
  "name": "saivage-v3-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "install:dev": "NODE_ENV=development npm install"
  },
  "dependencies": {
    "dompurify": "^3.4.7",
    "highlight.js": "^11.10.0",
    "marked": "^18.0.4",
    "pinia": "^2.3.1",
    "vue": "^3.5.16",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.10",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.6",
    "vue-tsc": "^2.2.12"
  },
  "sideEffects": [
    "src/utils/tool-presenters/**/*.ts",
    "src/styles/**/*.css"
  ]
}
