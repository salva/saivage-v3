{
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "bundler",
    "target": "ES2022",
    "module": "ESNext",
    "outDir": "dist",
    "rootDir": "..",
    "declaration": false,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "paths": {
      "@saivage/contracts": ["../src/contracts"],
      "@saivage/contracts/*": ["../src/contracts/*"],
      "@saivage/schemas": ["../src/schemas"],
      "@saivage/schemas/*": ["../src/schemas/*"],
      "@/*": ["./src/*"]
    },
    "types": ["vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "vite.config.ts",
    "env.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
