# npm configuration for saivage-v3 web subproject
#
# Always install devDependencies — overrides NODE_ENV=production behavior
# where npm would silently skip test tooling (vitest), TypeScript, linters, etc.
# Without this, NODE_ENV=production causes npm install to remove all devDependencies,
# making the web subproject's test suites uninstallable.
# Note: this is separate from the root .npmrc because web/ is its own npm project;
# npm does not read parent .npmrc files for non-workspace subprojects.
include=dev
