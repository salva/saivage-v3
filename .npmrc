# npm configuration for saivage-v3

# Save exact versions for reproducible builds
save-exact=true

# IMPORTANT: If your NODE_ENV is set to 'production', npm will skip
# devDependencies during install.  Unset it or run:
#   NODE_ENV=development npm install
# to get all dev dependencies including test tooling, pino-pretty, etc.
#
# You can verify this is the culprit by checking:
#   echo $NODE_ENV
#
# If it shows 'production', the following will be missing after npm install:
#   - jest (test runner)
#   - typescript (compiler)
#   - pino-pretty (pretty-printed dev logs)
#   - eslint, prettier (linting/formatting)
#   - vitepress (docs builder)
